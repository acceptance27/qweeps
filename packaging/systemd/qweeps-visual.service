[Unit]
Description=QWEEPS Visual Learner Studio Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Work/qweeps
ExecStart=%h/Work/qweeps/.venv/bin/python -m assistant.visual.server
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
