{
  "name": "qweeps-visual-studio-root",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "visual-studio"
  ],
  "scripts": {
    "dev": "vite visual-studio --config visual-studio/vite.config.ts --port=3000 --host=0.0.0.0",
    "build": "vite build visual-studio --config visual-studio/vite.config.ts && node visual-studio/scripts/copy_notices.mjs",
    "notices": "node visual-studio/scripts/copy_notices.mjs",
    "lint": "tsc -p visual-studio/tsconfig.json --noEmit",
    "test": "npm --prefix visual-studio test",
    "android:build": "bash scripts/build_android.sh",
    "android:check": "bash scripts/build_android.sh --check"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.211",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "elkjs": "^0.12.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "opentype.js": "^2.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
