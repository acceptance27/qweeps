{
  "name": "qweeps-visual-studio-root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "visual-studio"
  ],
  "scripts": {
    "postinstall": "ln -sfn ../node_modules visual-studio/node_modules",
    "dev": "vite visual-studio --config visual-studio/vite.config.ts --port=3000 --host=0.0.0.0",
    "build": "vite build visual-studio --config visual-studio/vite.config.ts && rm -rf dist && cp -r visual-studio/dist dist",
    "lint": "tsc -p visual-studio/tsconfig.json --noEmit",
    "test": "npm --prefix visual-studio test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hyperframes/core": "0.8.211",
    "@hyperframes/player": "0.8.211",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opentype.js": "^2.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
